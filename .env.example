# ==============================================================================
# SNIST AI QR Attendance & ERP System — Environment Configuration Template
# Copy this file to .env and backend/.env, and populate with production values.
# DO NOT COMMIT REAL PASSWORDS, CREDENTIALS, OR PRIVATE KEYS TO VERSION CONTROL.
# ==============================================================================

# --- Security & Cryptographic Keys ---
SECRET_KEY=generate_with_openssl_rand_hex_32
QR_SECRET_KEY=generate_with_openssl_rand_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
STUDENT_TOKEN_EXPIRE_SECONDS=30
DEVICE_BINDING_MINUTES=30
MAX_BINDING_AUTH_ATTEMPTS=5

# --- Database Connection (MySQL / SEG Database) ---
# Format: mysql+pymysql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=mysql+pymysql://db_user:db_password@seg-dev.sreenidhi.edu.in:3306/seg_demo

# --- Production Domain & URLs ---
FRONTEND_URL=https://ather-os.de5.net

# --- Primary SMTP Channel (Google Gmail — Magic Links, Notices & Schedule Emails) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=helpdesk@sreenidhi.edu.in
SMTP_PASSWORD=your_gmail_app_password_here
SMTP_USE_TLS=True
SMTP_SENDER=helpdesk@sreenidhi.edu.in
SMTP_SENDER_NAME="SNIST ERP System"

# --- Secondary SMTP Channel (Zoho Mail — OTP Verification & Login Credentials) ---
SMTP_OTP_HOST=smtp.zoho.in
SMTP_OTP_PORT=465
SMTP_OTP_USER=certificates@proofsy.tech
SMTP_OTP_PASSWORD=your_zoho_smtp_password_here
SMTP_OTP_USE_SSL=true
SMTP_OTP_SENDER=certificates@proofsy.tech
SMTP_OTP_SENDER_NAME="Proofsy Certificates"
SMTP_OTP_REPLY_TO=support@proofsy.tech

# --- Student Self-Service Onboarding & Magic Links ---
MAGIC_LINK_EXPIRY_HOURS=48
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_MAX_REQUESTS_PER_HOUR=5
MAX_DEVICE_REBINDS_PER_SEMESTER=5
STUDENT_PIN_MIN_LENGTH=4
STUDENT_PIN_MAX_LENGTH=6

# --- Bulk Credential Dispatch Queue ---
MAX_BATCH_SIZE=500
EMAIL_BATCH_CHUNK_SIZE=25
EMAIL_BATCH_DELAY_SECONDS=2.0

# --- Two-Layer Security Alerting & Detection System ---
SECURITY_ALERT_EMAIL=23311a05y6@cse.sreenidhi.edu.in
SECURITY_ALERTS_ENABLED=true
SECURITY_ALERT_COOLDOWN_MIN=10
SECURITY_DIGEST_ENABLED=true
SECURITY_DIGEST_START_HOUR=9
SECURITY_DIGEST_END_HOUR=17

# --- Google Sheets Integration (Optional) ---
GOOGLE_CREDENTIALS_FILE=
GOOGLE_SPREADSHEET_ID=113b1RKUGQGHtoViEFJjgeGxD1VzxaGgSAn0Guxh_ni8
